# ───────────────────────────── aurum-desk ─────────────────────────────
# Copy to .env and adjust. The app runs with ZERO keys using replay data.

# Market data provider used by the server's live engine
#   replay      → replays REAL historical M1 candles (Postgres or data/*.csv), speed-controllable (default)
#   twelvedata  → live XAU/USD 1min via Twelve Data (needs TWELVEDATA_API_KEY)
#   mock        → synthetic ticks. Unit tests / explicit dev only. UI shows a loud "MOCK DATA" badge.
MARKET_DATA_PROVIDER=replay
TWELVEDATA_API_KEY=

# Replay options (only when MARKET_DATA_PROVIDER=replay)
REPLAY_SOURCE=csv                 # csv | postgres
REPLAY_CSV_PATH=./data/xauusd-m1-sample.csv
REPLAY_SPEED=20                   # candles per second multiplier (1 = realtime, 20 = 20× faster)
REPLAY_START=                     # optional ISO timestamp to start from
REPLAY_WARMUP_BARS=3000           # M1 bars preloaded before replay starts

# Which `source` column the engine reads from Postgres (dukascopy | twelvedata | mt5csv | tradingview)
ENGINE_CANDLE_SOURCE=dukascopy

# LLM
#   anthropic | openai | ollama | none   (none → rule-based explanations, agents say so)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5          # ganti ke claude-sonnet-5-5 / claude-haiku-4-5 bila ingin lebih hemat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
LLM_MAX_TOKENS_PER_CYCLE=6000     # hard cap per candle-close cycle (all agents combined)
LLM_DAILY_TOKEN_BUDGET=400000     # soft daily budget shown in the "LLM spend" metric

# Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk model (used by the Risk agent for position-size suggestions)
RISK_PERCENT=1
ACCOUNT_SIZE=10000

# Database (PostgreSQL 16 + TimescaleDB, see docker-compose.yml)
DATABASE_URL=postgres://aurum:aurum@localhost:5432/aurum

# Server / web
SERVER_PORT=4000
SERVER_HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
SYMBOL=XAUUSD
LOG_LEVEL=info

# Ingest (apps/ingest)
INGEST_SOURCES=dukascopy          # comma list: dukascopy,twelvedata,mt5csv,tradingview
INGEST_BACKFILL_FROM=2024-01-01   # first run backfills from here (≥ 2 years recommended)
INGEST_CRON_INCREMENTAL=*/5 * * * *
INGEST_CRON_RECONCILE=0 2 * * *
TRADINGVIEW_ENABLED=false         # unofficial adapter, see README disclaimer
